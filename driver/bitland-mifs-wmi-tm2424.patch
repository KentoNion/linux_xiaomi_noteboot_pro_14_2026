+static umode_t laptop_attrs_is_visible(struct kobject *kobj,
+				       struct attribute *attr, int n)
+{
+	struct device *dev = kobj_to_dev(kobj);
+	struct bitland_mifs_wmi_data *data = dev_get_drvdata(dev);
+
+	if (data->thin_ultrabook)
+		return 0;
+
+	return attr->mode;
+}
